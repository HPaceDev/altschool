# Строка подключения к PostgreSQL.
# Локально:  postgresql://altschool:altschool@127.0.0.1:5432/altschool
# Supabase:  Project Settings -> Database -> Connection string -> URI (режим Session)
DATABASE_URL=postgresql://altschool:altschool@127.0.0.1:5432/altschool

# Адрес портала — используется в ссылках для входа. Если не задать,
# он определяется из заголовков запроса.
APP_URL=http://localhost:3000

# Секрет для подписи сессионных токенов. Сгенерировать: openssl rand -hex 32
AUTH_SECRET=change-me-openssl-rand-hex-32

# Почта владельца портала: этот пользователь получает роль owner при первом заходе.
OWNER_EMAIL=you@example.com

# Отправка писем со ссылками для входа. Пока ключа нет, ссылка печатается
# в серверную консоль — портал полностью работоспособен и без почты.
RESEND_API_KEY=
MAIL_FROM=
