# Строка подключения к PostgreSQL.
# Локально:  postgresql://altschool:altschool@127.0.0.1:5432/altschool
# Supabase:  Project Settings -> Database -> Connection string -> URI (Session pooler)
DATABASE_URL=postgresql://altschool:altschool@127.0.0.1:5432/altschool

# Адрес портала. Можно не задавать — тогда он определяется из заголовков
# запроса. Заданное значение надёжнее: подменить его через заголовок нельзя.
APP_URL=http://localhost:3000
